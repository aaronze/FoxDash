<div class="dashboard-row">
  <div class="dashboard-column current-weather weather-widget" id="current-weather-widget">
    <h3>Today</h3>
    <h2 id="current-title">Current Weather</h2>
    <p class="temperature" id="current-temperature">--°C</p>
    <p class="weather" id="current-weather">Loading...</p>
  </div>

  <div class="dashboard-column forecast-weather">
    <% 5.times do |index| %>
    <div class="dashboard-row forecast-row weather-widget" id="forecast-widget-<%= index + 1 %>">
      <h2 id="forecast-title-<%= index + 1 %>"></h2>
      <p class="temperature" id="forecast-temperature-<%= index + 1 %>"></p>
      <p class="weather" id="forecast-weather-<%= index + 1 %>"></p>
    </div>
    <% end %>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    fetch('/weather')
        .then(response => response.json())
        .then(weather => {
          document.getElementById('current-title').textContent = formatDate(weather.current.time);
          document.getElementById('current-temperature').textContent = weather.current.temperature_2m + "°C";
          document.getElementById('current-weather').textContent = describeWeather(weather.current.weather_code);
          // Todo: Remove other weather codes
          document.getElementById('current-weather-widget').classList.add(weatherCategory(weather.current.weather_code))

          weather.daily.temperature_2m_max.forEach((temp, index) => {
            document.getElementById('forecast-temperature-' + (index + 1)).textContent = temp + "°C";
          });
          weather.daily.weather_code.forEach((code, index) => {
            // document.getElementById('forecast-weather-' + (index + 1)).textContent = describeWeather(code);
            // Todo: Remove other weather codes
            document.getElementById('forecast-widget-' + (index + 1)).classList.add(weatherCategory(code))
          });
        });
  });

